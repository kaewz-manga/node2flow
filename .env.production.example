# === Auth.js ===
AUTH_URL=https://node2flow.net
AUTH_TRUST_HOST=true
AUTH_SECRET=                          # Generate: openssl rand -hex 32
AUTH_GOOGLE_ID=                       # Google Cloud Console > OAuth 2.0 Client ID
AUTH_GOOGLE_SECRET=                   # Google Cloud Console > OAuth 2.0 Client Secret

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# === n8n Integration ===
N8N_API_URL=https://n8n-no1.missmanga.org
N8N_API_KEY=                              # n8n API key (Settings > API > Create API Key)
ADMIN_EMAIL=node2flow@gmail.com

# === Gmail SMTP ===
GMAIL_USER=node2flow@gmail.com
GMAIL_APP_PASSWORD=                       # Google App Password (myaccount.google.com/apppasswords)

# === App ===
NEXT_PUBLIC_BASE_URL=https://node2flow.net
